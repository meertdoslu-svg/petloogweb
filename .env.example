# PetLoog website
# Canonical production domain is the apex (no "www").
NEXT_PUBLIC_SITE_URL=https://petloog.com

# Supabase — anon key only (public by design, protected by RLS).
# Used by /auth/confirm (e-mail confirmation) and to read published blog
# posts (blog_posts). The site never uses the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# E-mail via Resend — ön kayıt (/isletmeler) and iletişim (/iletisim) forms.
# Server-only: never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g.:
RESEND_FROM="PetLoog Web <basvuru@petloog.com>"
# Optional recipients, both default to info@petloog.com
PREREG_MAIL_TO=info@petloog.com
CONTACT_MAIL_TO=info@petloog.com
