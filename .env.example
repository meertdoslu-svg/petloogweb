# PetLoog website
# Canonical production domain is the apex (no "www").
NEXT_PUBLIC_SITE_URL=https://petloog.com

# Supabase — still used by /auth/confirm (e-mail confirmation), the contact
# form (contact_messages) and published blog posts (blog_posts).
# The anon key is public by design (RLS); the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ön kayıt formu (/isletmeler) → e-posta via Resend. Server-only, never
# prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g.:
RESEND_FROM="PetLoog Web <basvuru@petloog.com>"
# Optional, defaults to info@petloog.com
PREREG_MAIL_TO=info@petloog.com
